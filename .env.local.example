# Backend URL, with the protocol (https://...)
API_BASE_URL=https://your-backend-url
# Backend API key, sent server-side only as X-API-Key
API_KEY=your-api-key

# Optional: comma-separated LAN addresses allowed to use the dev server
# (e.g. to test on a phone on the same Wi-Fi network)
# ALLOWED_DEV_ORIGINS=192.168.1.34
